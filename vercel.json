{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "buildCommand": "python scripts/init_db.py",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{test_*.py,tests/**,.venv/**,__pycache__/**,*.sqlite3,*.sqlite3-*,DEVELOPMENT_HISTORY.md}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}
      ]
    }
  ]
}
