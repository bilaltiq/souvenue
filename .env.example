# Copy the Session pooler URI from Supabase > Connect. Replace the password
# with its URL-encoded value. Never commit your real connection string.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
# Disable simulated attendance and the founder's editor on hosted deployments.
ENCORE_DEMO_CHECKINS=0
# Optional exact origins, comma-separated. The current HTTPS host is also allowed.
ALLOWED_ORIGINS=
